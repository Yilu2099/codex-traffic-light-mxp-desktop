<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.traffic-light-mxp-updater</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UPDATER_PATH__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.wanhe-codex-token/logs/updater-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.wanhe-codex-token/logs/updater-launchd.err.log</string>
</dict>
</plist>
